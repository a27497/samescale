# Development-only values. Never reuse these credentials outside local development.
HARNESSLAB_ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://harnesslab:harnesslab_dev_only@localhost:5432/harnesslab
HARNESSLAB_WORKBENCH_ARTIFACT_ROOTS='["artifacts","harnesslab-artifacts"]'
POSTGRES_DB=harnesslab
POSTGRES_USER=harnesslab
POSTGRES_PASSWORD=harnesslab_dev_only

# Phase K-B v2 provider configuration references. Empty until separately authorized real smoke.
# OpenCode Go provider URLs are frozen in the v2 release contract; only its API key is configured here.
HARNESSLAB_GPT56_RELAY_BASE_URL=
HARNESSLAB_GPT56_RELAY_API_KEY=
HARNESSLAB_OPENCODE_GO_API_KEY=
DEEPSEEK_API_KEY=
