  "comparison_types": [
    {
      "id": "end-to-end-system-comparison",
      "description": "Different model, harness, or provider identities may vary together.",
      "comparison_type": "END_TO_END_SYSTEM_COMPARISON",
      "required_controls": ["task", "context", "verifier", "declared budget"],
      "declared_treatment": "complete evaluated system",
      "claim_boundary": "System-level association only; never claim pure model or harness uplift."
    },
    {
      "id": "model-comparison",
      "description": "Only model identity is the declared treatment.",
      "comparison_type": "MODEL_COMPARISON",
      "required_controls": ["harness", "scaffold", "task", "budget", "provider route", "network"],
      "declared_treatment": "model identity",
      "claim_boundary": "Model comparison only while every declared hard control remains comparable."
    },
    {
      "id": "harness-uplift",
      "description": "Harness or profile is the declared treatment under a shared model and provider route.",
      "comparison_type": "HARNESS_UPLIFT",
      "required_controls": ["model", "provider route", "task", "context", "verifier", "budget", "network"],
      "declared_treatment": "harness/profile",
      "claim_boundary": "A model or provider identity difference blocks a harness-uplift claim."
    },
    {
      "id": "controlled-ablation",
      "description": "Exactly one preregistered treatment dimension changes.",
      "comparison_type": "CONTROLLED_ABLATION",
      "required_controls": ["all dimensions except the single declared treatment"],
      "declared_treatment": "one named dimension",
      "claim_boundary": "Any undeclared drift reclassifies the comparison as end-to-end system evidence."
    }
  ],
